RewriteEngine On

# --------------------------------------------------
# Optional: Force HTTPS + remove www (uncomment on live)
# --------------------------------------------------
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://sit.vic.edu.au%{REQUEST_URI} [L,R=301]

# --------------------------------------------------
# Block sensitive folders
# --------------------------------------------------
RewriteRule ^(includes|data|email)(/|$) - [F,L]

# --------------------------------------------------
# Homepage: /index and /index.php → /
# --------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# --------------------------------------------------
# Course detail pages
# Example: /Building-and-Construction/certificate-iii-in-solid-plastering
# --------------------------------------------------
RewriteRule ^(building-and-construction|engineering|business-and-management)/([a-z0-9-]+)/?$ course.php?category=$1&slug=$2 [L,QSA]

# --------------------------------------------------
# Serve pages without .php extension
# Example: /contact  →  contact.php
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1.php [L]

# --------------------------------------------------
# Redirect direct .php requests to clean URL
# Example: /contact.php  →  /contact
# --------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --------------------------------------------------
# Security
# --------------------------------------------------
Options -Indexes

<FilesMatch "^\.|^(env|config)\.php$|\.(env|sql|log|bak|ini)$">
    Require all denied
</FilesMatch>